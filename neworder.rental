</style>  <script>  
/* Make the existing server-rendered [error_message] dismissible.  
   It does not create or fake order success; it only decorates the  
   message that the panel backend already returns. */  
(function () {  
    function enhanceOrderResultMessages() {  
        var formArea = document.querySelector('#main_container .newordersr');  
        if (!formArea) return;  
  
        var candidates = formArea.querySelectorAll(  
            '.alert, .alert-success, .alert-danger, .alert-warning, .alert-info, .alert-dismissible'  
        );  
  
        candidates.forEach(function (message) {  
            if (message.dataset.sfPopupEnhanced === '1') return;  
            if (!message.textContent || !message.textContent.trim()) return;  
  
            message.dataset.sfPopupEnhanced = '1';  
            message.classList.add('sf-order-result-popup');  
            message.setAttribute('role', 'status');  
            message.setAttribute('aria-live', 'polite');  
  
            var closeButton = document.createElement('button');  
            closeButton.type = 'button';  
            closeButton.className = 'sf-order-popup-close';  
            closeButton.setAttribute('aria-label', 'Close order message');  
            closeButton.setAttribute('title', 'Close');  
            closeButton.innerHTML = '&times;';  
            closeButton.addEventListener('click', function () {  
                message.classList.add('sf-order-popup-closing');  
                window.setTimeout(function () {  
                    if (message && message.parentNode) message.parentNode.removeChild(message);  
                }, 240);  
            });  
            message.appendChild(closeButton);  
        });  
    }  
  
    if (document.readyState === 'loading') {  
        document.addEventListener('DOMContentLoaded', enhanceOrderResultMessages);  
    } else {  
        enhanceOrderResultMessages();  
    }  
  
    /* Some panel themes insert result alerts after page scripts run. */  
    var root = document.querySelector('#main_container .newordersr');  
    if (root && window.MutationObserver) {  
        var observer = new MutationObserver(function () {  
            enhanceOrderResultMessages();  
        });  
        observer.observe(root, { childList: true, subtree: true });  
    }  
})();  
</script>  <!-- ==========================================================  
