}  
.card{  
    border:0 solid!important;  
}  
.nightmode a{  
    color:#007bff;  
}  
.nightmode .announcement_inner .left_ann p{  
    color:white;  
}  
.nightmode .btn_announcement{  
    background:#0F172A;  
}  
@media only screen and (max-width:550px){  
    .announcement_inner{  
        flex-direction:column;  
        gap:10px;  
        padding:0;  
    }  
}  
.announcement_inner{  
    display:flex;  
    padding:10px 0;  
    justify-content:space-between;  
}  
.announcement_inner .left_ann h4{  
    font-size:16px;  
    font-weight:800;  
    margin-bottom:3px;  
}  
@media only screen and (max-width:550px){  
    .announcement_inner .left_ann p{  
        font-size:12px;  
    }  
}  
@media only screen and (max-width:992px){  
    .announcement_inner .left_ann p{  
        font-size:13px;  
    }  
}  
.announcement_inner .left_ann p{  
    font-size:13px;  
    color:var(--text-black);  
    font-weight:normal;  
}  
@media only screen and (max-width:550px){  
    .btn_announcement{  
        font-size:14px;  
    }  
}  
@media only screen and (max-width:992px){  
    .btn_announcement{  
        font-size:16px;  
    }  
}  
.btn_announcement{  
    border-radius:10px;  
    background:#F0ECFC;  
    font-size:12px;  
    font-family:var(--font-text);  
    font-weight:600;  
    transition:.5s;  
}  
@media only screen and (max-width:550px){  
    .user_statistic_wraper .statistic__item .statistic_inner{  
        gap:5px;  
        padding:5px 10px;  
    }  
}  
.nightmode .border-solid{  
    background:#0F172A;  
    color:white;  
}  
.border-solid{  
    border:0 solid #ddd;  
    height:25px;  
    padding-left:5px;  
    background:#E9F2FC;  
}  
.fab{  
    font-size:20px;  
}  
@media only screen and (max-width:550px){  
    .filter_btn_wrap .btn_filter .filter_txt{  
        display:none!important;  
    }  
}  
@media only screen and (max-width:550px){  
    .filter_btn_wrap{  
        grid-template-columns:repeat(4,1fr);  
        height:150px;  
        overflow:hidden;  
        overflow-y:scroll;  
        grid-gap:8px 10px;  
    }  
}  
li.selected{  
    background-color:#63c5ff;  
    color:white;  
}  
a.forget-pass,.form-group{  
    font-size:15px;  
    color:#000000!important;  
}  
.nightmode marquee{  
    color:white;  
}  
.currency-name-span{  
    color:black;  
}  
.nightmode span{  
    color:white;  
}  
span{  
    font-weight:500;  
}  
@media only screen and (max-width:550px){  
    .for_desktop{  
        display:none;  
    }  
    .for_phone{  
        display:block;  
    }  
}  
.user_statistic_wraper{  
    display:grid;  
    grid-template-columns:repeat(4,1fr);  
    gap:5px;  
    margin-bottom:20px;  
}  
.user_statistic_wraper .statistic__item{  
    display:flex;  
    flex-direction:row;  
    align-items:center;  
    gap:5px;  
    background:white;  
    padding:5px;  
    border-radius:10px;  
}  
.statistic__item .icon{  
    width:45px;  
}  
.statistic__item .user__data span{  
    font-size:14px!important;  
    font-weight:normal;  
    color:#232323;  
}  
.statistic__item .user__data h4{  
    font-size:20px;  
    font-weight:bold;  
    margin-bottom:0;  
}  
.nightmode .user_statistic_wraper .statistic__item{  
    background:#182741;  
    box-shadow:none;  
}  
.nightmode .statistic__item .user__data h4,  
.nightmode .statistic__item .user__data span{  
    color:#fff;  
}  
#service_description{  
    display:none;  
}  
@media only screen and (max-width:992px){  
    .user_statistic_wraper{  
        grid-template-columns:repeat(2,1fr);  
        gap:10px;  
    }  
}  
.statistic__item .icon{  
    width:45px;  
}  
.statistic__item .user__data span{  
    font-size:16px;  
    font-weight:normal;  
    color:#232323;  
}  
.statistic__item .user__data h4{  
    font-size:20px;  
    font-weight:bold;  
    margin-bottom:0;  
}  
#orderform-category,  
#orderform-service{  
    display:none;  
}  
.nightmode #category_filter .stats-wrap{  
    background-color:#3d8dff;  
}  
#category_filter .stats-wrap{  
    background-color:#fff;  
    border-radius:12px;  
    padding:20px 15px;  
    box-shadow:0 7px 26px 0 rgb(201 195 195 / 78%);  
    margin-bottom:0;  
    margin-top:20px;  
}  
#category_filter .stats-wrap .align_center{  
    display:flex;  
    justify-content:end;  
}  
#category_filter .stats-wrap .align_center i{  
    display:flex;  
    justify-content:center;  
    align-items:center;  
    width:40px;  
    height:40px;  
    background-color:#3d8dff;  
    color:#fff;  
    border-radius:50%;  
    font-size:20px;  
}  
.nightmode .stats-txt{  
    font-size:14px;  
    font-weight:700;  
    color:#fff;  
    margin-bottom:0;  
}  
.stats-txt{  
    color:#3d8dff;  
}  
.stats-title{  
    color:#3d8dff;  
}  
.nightmode .stats-title{  
    font-size:30px;  
    font-weight:600;  
    color:#fff;  
    margin-top:5px;  
}  
.stats-wrap img{  
    width:50px;  
}  
