</div>  <!-- =====================================================  
     EXISTING VIDEO GUIDE CSS — RETAINED  
===================================================== -->  <style>  
.sf-order-guide{  
    width:100%;  
    box-sizing:border-box;  
    padding:4px 0 10px;  
}  
.sf-guide-head{  
    display:flex;  
    align-items:center;  
    gap:14px;  
    margin-bottom:20px;  
}  
.sf-guide-icon{  
    width:76px;  
    height:76px;  
    min-width:76px;  
    border-radius:20px;  
    background:linear-gradient(135deg,#4285f4,#5b63f6);  
    display:flex;  
    align-items:center;  
    justify-content:center;  
    color:#fff;  
    font-size:30px;  
}  
.sf-guide-head h3{  
    margin:0!important;  
    padding:0!important;  
    font-size:27px!important;  
    font-weight:800!important;  
    color:#263238;  
}  
.sf-guide-head p{  
    margin:4px 0 0!important;  
    padding:0!important;  
    font-size:17px!important;  
    color:#8b95a5;  
}  
.sf-video-box{  
    width:100%;  
    position:relative;  
    overflow:hidden;  
    border-radius:24px;  
    background:#000;  
    box-shadow:0 10px 30px rgba(50,90,140,.12);  
    aspect-ratio:16 / 9;  
}  
.sf-video-box iframe{  
    position:absolute;  
    top:0;  
    left:0;  
    width:100%!important;  
    height:100%!important;  
    border:0;  
    display:block;  
    border-radius:24px;  
}  
.sf-before-order{  
    margin-top:25px;  
    padding:22px 24px;  
    border-radius:22px;  
    background:#f1f6ff;  
    border:1px solid #d9e7fa;  
}  
.sf-before-order h3{  
    margin:0 0 12px!important;  
    font-size:22px!important;  
    color:#2869c9;  
    font-weight:800!important;  
}  
.sf-before-order p{  
    margin:0!important;  
    font-size:16px!important;  
    line-height:1.7!important;  
    color:#596678;  
}  
.sf-steps{  
    display:grid;  
    grid-template-columns:repeat(3,1fr);  
    gap:12px;  
    margin-top:22px;  
}  
.sf-step{  
    min-height:115px;  
    padding:15px 8px;  
    border-radius:20px;  
    background:#f8fafc;  
    display:flex;  
    flex-direction:column;  
    align-items:center;  
    justify-content:center;  
    text-align:center;  
}  
.sf-step-icon{  
    font-size:32px;  
    line-height:1;  
    margin-bottom:12px;  
}  
.sf-step strong{  
    font-size:15px!important;  
    color:#374151;  
    font-weight:700!important;  
}  
.sf-guide-footer{  
    text-align:center;  
    padding:20px 8px 4px;  
    color:#8993a1;  
    font-size:16px;  
    line-height:1.6;  
}  
.nightmode .sf-guide-head h3{color:#fff;}  
.nightmode .sf-guide-head p{color:#aeb9ca;}  
.nightmode .sf-before-order{  
    background:#17243a;  
    border-color:#263956;  
}  
.nightmode .sf-before-order h3{color:#6fa5ff;}  
.nightmode .sf-before-order p{color:#c7d1df;}  
.nightmode .sf-step{background:#182741;}  
