    from{opacity:0;transform:translateY(7px);}  
    to{opacity:1;transform:translateY(0);}  
}  
  
/* Statistic cards */  
#main_container .user_statistic_wraper .statistic__item{  
    border:1px solid rgba(61,141,255,.12);  
