    margin: 0 38px 16px 0 !important;  
    color: #15563d !important;  
    font-weight: 800 !important;  
    line-height: 1.25 !important;  
}  
#main_container .newordersr .sf-order-result-popup p:last-child { margin-bottom: 0; }  
#main_container .newordersr .sf-order-result-popup.sf-order-popup-closing {  
    animation: sfOrderPopupOut .24s ease forwards !important;  
    pointer-events: none;  
}  
@keyframes sfOrderPopupIn {  
    0% { opacity: 0; transform: translateY(14px) scale(.985); }  
    65% { opacity: 1; transform: translateY(-2px) scale(1.003); }  
    100% { opacity: 1; transform: translateY(0) scale(1); }  
}  
@keyframes sfOrderPopupOut {  
    to { opacity: 0; transform: translateY(-8px) scale(.985); }  
}  
/* Keep error/neutral server messages readable; only successful results use green */  
#main_container .newordersr .sf-order-result-popup.alert-danger,  
#main_container .newordersr .sf-order-result-popup.alert-warning {  
    background: linear-gradient(135deg, #fff0ed 0%, #ffe6e1 100%) !important;  
    border-left-color: #e05a48 !important;  
    color: #842f26 !important;  
}  
#main_container .newordersr .sf-order-result-popup.alert-danger *,  
#main_container .newordersr .sf-order-result-popup.alert-warning * {  
    color: #842f26 !important;  
}  
#main_container .newordersr .sf-order-result-popup.alert-info {  
    background: linear-gradient(135deg, #eaf3ff 0%, #dceaff 100%) !important;  
    border-left-color: #4387f5 !important;  
    color: #204d87 !important;  
}  
#main_container .newordersr .sf-order-result-popup.alert-info * { color: #204d87 !important; }  
.nightmode #main_container .newordersr .sf-order-result-popup {  
