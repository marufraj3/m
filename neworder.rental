    .sf-guide-head p{font-size:14px!important;}  
    .sf-video-box{border-radius:20px;aspect-ratio:16 / 9;}  
    .sf-video-box iframe{border-radius:20px;}  
    .sf-before-order{  
        margin-top:18px;padding:18px;border-radius:18px;  
    }  
    .sf-before-order h3{font-size:19px!important;}  
    .sf-before-order p{font-size:14px!important;line-height:1.65!important;}  
    .sf-steps{gap:8px;margin-top:15px;}  
