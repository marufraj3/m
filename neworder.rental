</style>  <script>  
function filterStarted(e, filter) {  
    let btn_filter = document.getElementsByClassName("btn_filter");  
    if (document.querySelector("#categoryFIlterWraper button.activeItem") !== null) {  
        document.querySelector("#categoryFIlterWraper button.activeItem").classList.remove("activeItem");  
    }  
    e.classList.add("activeItem");  
    var data_finder = filter.toLowerCase();  
    var formField = document.getElementById("orderCategory");  
    var options = formField.options;  
    var set_selectPicker = 0;  
    for (a = 0; a < options.length; a++) {  
        var raw_o = options[a].innerText;  
        var o = options[a].innerText;  
        icon = options[a].getAttribute("data-icon");  
        if (typeof icon.length !== "undefined") {  
            if (icon.length > 0) { set_selectPicker = 1; }  
        }  
    }  
    if (options.length > 0) {  
        var matchFound = false;  
        for (a = 0; a < options.length; a++) {  
            var o = options[a].innerText.toLowerCase();  
            if (data_finder === "all") {  
                options[a].style.display = "block";  
                matchFound = true;  
            } else if (o.includes(data_finder)) {  
                options[a].style.display = "block";  
                matchFound = true;  
            } else {  
                options[a].style.display = "none";  
            }  
        }  
        if (!matchFound) {  
            options[a].style.display = "block";  
        } else {  
            var firstMatch = document.querySelector('#orderCategory option[style="display: block;"]');  
            if (firstMatch) {  
                document.getElementById("orderCategory").value = firstMatch.value;  
            }  
            if (set_selectPicker == 1) {  
                try { $("#orderCategory").selectpicker("destroy"); } catch (err) {}  
                $("#orderCategory").selectpicker();  
            }  
            change_cat();  
        }  
    }  
    if ($(".form-group .control-label .custom-select.my-select").hasClass("my-select")) {  
        $(".my-select").selectpicker("destroy");  
    } else if ($(".my-select").selectpicker("destroy")) {  
        $(".form-group .control-label .custom-select").addClass("my-select");  
        $(".my-select").selectpicker("");  
    }  
}  
</script>  <script>  
var post_data = "actionType=notifications&apiKey=[user.api_key]";  
var xhttp = new XMLHttpRequest();  
xhttp.onreadystatechange = function () {  
    if (this.readyState == 4 && this.status == 200) {  
        var response = JSON.parse(this.responseText);  
        var c = new Date();  
        var months = ["January","February","March","April","May","June","July","August","September","October","November","December"];  
        var cc = c.getDate() + " " + months[c.getMonth()];  
        var content = "";  
        if (typeof response.data !== "undefined") {  
            var d = response.data;  
            if (d.length > 0) {  
                for (a = 0; a < d.length; a++) {  
                    var f = d[a];  
                    var subject = "";  
                    if (typeof f.subject !== "undefined") { subject = f.subject; }  
                    var date = "";  
                    if (typeof f.date !== "undefined") { date = f.date; }  
                    var c = new Date(date);  
                    var months = ["January","February","March","April","May","June","July","August","September","October","November","December"];  
                    var date = c.getDate() + " " + months[c.getMonth()] + " " + c.getFullYear();  
                    var message = "";  
                    if (typeof f.message !== "undefined") { message = f.message; }  
                    var id = "";  
                    if (typeof f.id !== "undefined") { id = f.id; }  
                    if (message.length > 0) {  
                        content = content + ' <li class="singleNewsBlock"><div class="type-date"><p class="date"> &nbsp ' + date + ' </p></div><br><div class="news-desc">' + "<p><b>" + subject + "</b></p><p>" + message + "</p></div></li>";  
                    }  
                }  
            }  
        }  
        if (content.length == 0) {  
            content = '<li><h4>Notification<span class="date">' + cc + "</span></h4><p>No Notification Found</p></li>";  
        }  
        var newsElement = document.getElementById("news_updates_div");  
        if (newsElement) { newsElement.innerHTML = content; }  
    }  
};  
xhttp.open("POST", "api", true);  
xhttp.setRequestHeader("Content-type", "application/x-www-form-urlencoded");  
xhttp.send(post_data);  
</script>  <script>  
window.addEventListener("load", function () {  
    var monthly_spent = "[user.total_spent]";  
    var available_funds = "[user.available_funds]";  
    var total_orders = "[panel.last_order_id]";  
    monthly_spent = monthly_spent.replace(",", ".");  
    monthly_spent = parseFloat(monthly_spent);  
    available_funds = available_funds.replace(",", ".");  
    available_funds = parseFloat(available_funds);  
    total_orders = total_orders.replace(",", ".");  
    total_orders = parseFloat(total_orders);  
    var exchange_rate = "[panel.currency.exchange_rate]";  
    exchange_rate = exchange_rate.replace(",", ".");  
    exchange_rate = parseFloat(exchange_rate);  
    balance_limit = 1000 * exchange_rate;  
    var pcr_orders = (total_orders / 100000000) * 100;  
    prc_funds = (available_funds / balance_limit) * 100;  
    var subscriptions = '[{"name":"NEW","min":"0","max":"49.9999"},{"name":"JUNIOR","min":"50","max":"999.9999"},{"name":"FREQUENT","min":"1000","max":"2499.9999"},{"name":"ELITE","min":"2500","max":"14999.9999"},{"name":"VIP","min":"15000","max":"49999.9999"},{"name":"MASTER","min":"50000","max":"1000000000"}]';  
    subscriptions = JSON.parse(subscriptions);  
    if (subscriptions.length > 0) {  
        var total_subscription = subscriptions.length;  
        for (index = 0; index < subscriptions.length; index++) {  
            if (typeof subscriptions[index].min !== "undefined") {  
                var subs = subscriptions[index];  
                var min_spent = parseFloat(subs.min) * exchange_rate;  
                var max_spent = parseFloat(subs.max) * exchange_rate;  
                if (monthly_spent >= min_spent && monthly_spent <= max_spent) {  
                    var total_spent_limit = max_spent - min_spent;  
                    var above_monthly_spent = monthly_spent - min_spent;  
                    var remaining_spent = max_spent - above_monthly_spent;  
                    $(".account_status_span").html(subs.name);  
                }  
            }  
        }  
    }  
});  
</script>  </div>  
