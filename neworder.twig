/* SAFE Z INDEX */
#myModal{z-index:2000}
.modal-backdrop{z-index:1990}

/* BOX */
#myModal .bdTgBox{
  border-radius:18px;
  overflow:hidden;
  background:#111; /* fallback */
  box-shadow:0 18px 60px rgba(0,0,0,.35);
}

/* HEADER */
#myModal .bdTgHeader{
  padding:18px 16px 12px;
  position:relative;
}

/* LOGO */
#myModal .bdTgLogo{
  height:36px;
}

/* DIVIDER */
#myModal .bdLogoLine{
  width:60%;
  height:1px;
  background:rgba(255,255,255,.2);
  margin:12px auto 0;
}

/* TEXT */
#myModal .bdTgText{color:#fff}

#myModal .bdTgTitle{
  font-weight:700;
  font-size:18px;
}

#myModal .bdTgSub{
  font-size:13px;
  opacity:.85;
}

/* IMAGE */
#myModal .bdTgImageWrap{
  border-radius:14px;
  overflow:hidden;
}

#myModal .bdTgImage{
  width:100%;
  display:block;
}

/* BUTTON AREA */
#myModal .bdTgFooter{
  display:flex;
  gap:12px;
}

#myModal .bdTgFooter .btn{
  flex:1;
  border-radius:14px;
  padding:12px;
  font-weight:600;
  border:none;
}

/* CLOSE */
#myModal .bdBtnClose{
  background:#ef4444;
  color:#fff;
}

/* JOIN BTN */
#myModal .bdBtnJoin{
  position:relative;
  background:#229ED9;
  color:#fff;
  overflow:hidden;
  transition:.25s;
  box-shadow:
  0 0 10px rgba(34,158,217,.6),
  0 0 25px rgba(34,158,217,.4);
}

/* SHINE */
#myModal .bdBtnJoin::before{
  content:"";
  position:absolute;
  top:0;
  left:-75%;
  width:50%;
  height:100%;
  background:linear-gradient(
    120deg,
    transparent,
    rgba(255,255,255,.7),
    transparent
  );
  transform:skewX(-25deg);
  animation:shineMove 2.8s infinite;
}

@keyframes shineMove{
  0%{left:-75%}
  100%{left:130%}
}

#myModal .bdBtnJoin:hover{
  transform:translateY(-2px);
}

/* MOBILE */
@media(max-width:575px){
  #myModal .modal-dialog{margin:12px;}
}
