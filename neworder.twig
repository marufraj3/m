{% include 'header.twig' %}
<style>
 /* ================================
   Select2 + UI Global Fixes (Assembled)
================================ */

/* ================================================
   Category + Service Dropdown (Select2)
   FULL RESPONSIVE (mobile / tablet / desktop)
================================================ */

/* Native select hidden thakbe (Select2 UI dekhabe) */
#neworder_category,
#neworder_services{
  display: none !important;
}

/* Flex-column form er item gula jeno lomba text er karone overflow na kore */
.component_button_forms > *,
#neworder_fields > *{
  min-width: 0;
  max-width: 100%;
}
.component_button_forms .form-group{
  width: 100%;
  min-width: 0;
}

/* ---------- 1) SELECT BOX: sob somoy 100% width ---------- */
/* Select2 inline style e "width:auto" / "width:123px" bosay -> eta override */
.component_button_forms .select2-container{
  display: block !important;
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;
  box-sizing: border-box;
}

.component_button_forms .select2-container .select2-selection--single{
  position: relative;
  display: block;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  background-color: #e5fff8 !important;
  border: 1px solid #05c191 !important;
  outline: none !important;
  cursor: pointer;
  transition: box-shadow .15s ease;
}

.component_button_forms .select2-container .select2-selection--single .select2-selection__rendered{
  display: block;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
  padding-right: 38px;
  font-size: 15px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.component_button_forms .select2-container .select2-selection--single .select2-selection__arrow{
  position: absolute;
  top: 0;
  right: 6px;
  height: 100%;
  width: 24px;
}

/* Focus / Open */
.component_button_forms .select2-container--focus .select2-selection--single,
.component_button_forms .select2-container--open .select2-selection--single{
  border-color: #05c191 !important;
  box-shadow: 0 0 0 3px rgba(5,193,145,.15);
}
.component_button_forms .select2-container--open .select2-selection--single{
  border-bottom-left-radius: 0 !important;
  border-bottom-right-radius: 0 !important;
}

/* ---------- 2) DROPDOWN PANEL (body te attach hoy) ---------- */
.select2-container--open .select2-dropdown{
  box-sizing: border-box;
  border: 1px solid #05c191 !important;
  border-radius: 0 0 8px 8px;
  z-index: 999999 !important;
  max-width: calc(100vw - 16px) !important;   /* screen er baire jabe na */
  overflow: hidden;
  background: #fff;
  box-shadow: 0 12px 30px rgba(0,0,0,.12);
}

/* Result list: ekta-i scroll, height screen onujayi */
.select2-results__options{
  max-height: 390px !important;
  max-height: min(390px, 60vh) !important;
  overflow-y: auto !important;
  overflow-x: hidden !important;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior: contain;
}

/* Option: lomba name wrap hobe, cut hobe na */
.select2-results__option{
  border-bottom: 1px solid #05c19133;
  border-radius: 0 !important;
  padding: 8px 12px;
  font-size: 15px;
  line-height: 1.45;
  white-space: normal !important;
  word-break: break-word;
  overflow-wrap: anywhere;
}
.select2-results__option:last-child{
  border-bottom: 0;
}

/* Option er vitorer badge (ID / rate) */
.select2-results__option .badge{
  display: inline-block;
  vertical-align: middle;
  white-space: nowrap;
  font-size: 11px;
  line-height: 1.2;
  padding: 3px 8px;
  margin-right: 4px;
}
.select2-results__option.select2-results__option--selected.select2-results__option--selectable .badge{
  background-color: #000;
}

/* Selected option */
.select2-results__option.select2-results__option--selected.select2-results__option--selectable{
  background-color: #05c191;
  color: #fff;
}

/* Dropdown er vitorer search box hide */
.select2-search--dropdown{
  display: none !important;
}

/* Hover / highlight */
.select2-results__option--highlighted,
.select2-results__option:hover{
  font-weight: normal !important;
  transition: none !important;
}
.select2-results__option[aria-selected]:hover{
  background-color: #05c1912e !important;
  cursor: pointer;
}
.select2-results__option.select2-results__option--highlighted.select2-results__option--selectable{
  color: #141627 !important;
}
.select2-results__option--highlighted{
  background-color: #05c1912e !important;
  transition: background-color 0.2s ease;
}
.select2-results__option--selected.select2-results__option--highlighted{
  background-color: #05c191 !important;
  color: #fff !important;
}

/* Scrollbar */
.select2-results__options::-webkit-scrollbar{ width: 6px; }
.select2-results__options::-webkit-scrollbar-track{ background: #f1f1f1; }
.select2-results__options::-webkit-scrollbar-thumb{
  background: #05c191;
  border-radius: 3px;
}

/* Dropdown sob somoy niche khulbe (flip off) */
.select2-container--open .select2-dropdown--above{
  top: 100% !important;
  bottom: auto !important;
}

/* Search services result box o full width */
#searchServicesResultsDropdown{
  width: 100% !important;
  max-width: 100%;
  box-sizing: border-box;
  max-height: 60vh;
  overflow-y: auto;
}

/* ---------- 3) TABLET + MOBILE (<= 991px) ---------- */
/* Selected service name 2 line porjonto dekhabe (tarpor ...), box auto-height */
@media (max-width: 991.98px){
  .component_button_forms .select2-container .select2-selection--single{
    height: auto !important;
    min-height: 44px;
    padding: 9px 0 !important;
  }
  .component_button_forms .select2-container .select2-selection--single .select2-selection__rendered{
    display: -webkit-box !important;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    white-space: normal !important;
    word-break: break-word;
    overflow-wrap: anywhere;
    line-height: 1.45 !important;
    height: auto !important;
    max-height: none !important;
    padding: 0 38px 0 12px !important;
    font-size: 14px;
  }
  .select2-results__option{
    font-size: 14px;
    padding: 10px 12px;   /* touch friendly */
  }
  .select2-results__options{
    max-height: 320px !important;
    max-height: min(320px, 55vh) !important;
  }
}

/* ---------- 4) SMALL PHONE (<= 575px) ---------- */
@media (max-width: 575.98px){
  .select2-container--open .select2-dropdown{
    max-width: calc(100vw - 12px) !important;
    border-radius: 0 0 6px 6px;
  }
  .select2-results__options{
    max-height: 50vh !important;
  }
  .select2-results__option{
    font-size: 13.5px;
    padding: 9px 10px;
  }
  .component_button_forms .select2-container .select2-selection--single .select2-selection__rendered{
    font-size: 13.5px;
    padding: 0 34px 0 10px !important;
  }
}

/* Generic badge */
.badge{
  min-width: 30px;
  background: var(--primary-color);
  color: var(--white);
  border-radius: 20px;
}

/* Remove shadow from search results wrap */
.body .form-group .search-results{
  box-shadow: none !important;
}

/* Active button */
button.active{
  background: var(--primary-color) !important;
  border-color: var(--primary-color) !important;
  color: var(--white) !important;
}

/* ================================
   Platforms Grid
================================ */
.platforms{
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 15px 20px;
}

@media only screen and (max-width: 550px){
  .platforms{ grid-template-columns: repeat(6, 1fr); }
}

@media only screen and (max-width: 400px){
  .platforms{ grid-template-columns: repeat(4, 1fr); }
}

.platforms-item{
  box-sizing: border-box;
  padding-bottom: 8px;
}

.platforms-item__with-icon{
  display: flex;
  align-items: center;
  gap: 8px;
}

.platforms-item__without-icon{
  display: flex;
  align-items: center;
  justify-content: center;
}

.platforms-item__icon{
  display: flex;
  max-height: 72px;
  height: calc(1em + 10px);
  width: calc(1em + 10px);
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--platforms_icon_color);
}

.platforms-item__icon svg{
  display: block;
  width: 100%;
  height: auto;
}

.platforms-item__title{
  overflow: hidden;
  white-space: nowrap;
  color: var(--platforms_text_color);
}

.platforms-item button{
  width: 100%;
  min-height: 40px;
  font-weight: 400;
  font-style: normal;
  padding: 8px 16px;
  background: var(--platforms_background_color);
  border-color: var(--platforms_border_color);
  border-style: solid;
  border-radius: 8px;
  border-width: 1px;
}

.platforms-item button:hover{
  background: var(--platforms_hover_background_color);
  border-color: var(--platforms_hover_border_color);
}

.platforms-item button:hover .platforms-item__title{
  color: var(--platforms_hover_text_color);
}

.platforms-item button:hover .platforms-item__icon{
  color: var(--platforms_hover_icon_color);
}

.platforms-item button.active .platforms-item__title{
  color: var(--platforms_active_text_color) !important;
}

.platforms-item button.active .platforms-item__icon{
  color: var(--platforms_active_icon_color) !important;
}

/* Nightmode + Bootstrap dark mode */
.dashboard.nightmode .platforms-item__with-icon,
[data-bs-theme="dark"] .platforms-item__with-icon{
  background-color: #000 !important;
  color: #fff !important;
  border-color: #333 !important;
}

.dashboard.nightmode .platforms-item__with-icon:hover,
[data-bs-theme="dark"] .platforms-item__with-icon:hover{
  background-color: #1a1a1a !important;
  color: #fff !important;
}

.dashboard.nightmode .platforms-item__with-icon.active,
[data-bs-theme="dark"] .platforms-item__with-icon.active{
  background-color: #1a1a1a !important;
  color: var(--text-primary) !important;
}

.dashboard.nightmode .platforms-item__title,
[data-bs-theme="dark"] .platforms-item__title{
  color: #fff !important;
}

.dashboard.nightmode .platforms-item__with-icon.active .platforms-item__title,
[data-bs-theme="dark"] .platforms-item__with-icon.active .platforms-item__title{
  color: var(--text-primary) !important;
}

.dashboard.nightmode .category_filter_wrap,
[data-bs-theme="dark"] .category_filter_wrap{
  background-color: #000 !important;
}

.dashboard.nightmode .card_v2,
[data-bs-theme="dark"] .card_v2{
  background-color: #000 !important;
  color: #fff !important;
}

.dashboard.nightmode .card_v2 .card-body,
[data-bs-theme="dark"] .card_v2 .card-body{
  background-color: #000 !important;
  color: #fff !important;
}

/* Mobile: icon-only */
@media (max-width: 768px){
  .platforms-item__with-icon{
    justify-content: center;
    gap: 0;
  }
  .platforms-item__title{
    display: none;
  }
}

/* ================================
   Alert Close Button
================================ */
.alert .close{
  background: rgba(0,0,0,0.06);
