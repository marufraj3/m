<!-- 3. SCRIPT WITH FIXED LOGIC -->
<script>
document.addEventListener("DOMContentLoaded", function() {
    const apiUrl = 'https://pay.bdclick24.com/admin/api_notice.php?time=' + new Date().getTime();
    let popupsQueue = []; 
    let currentIndex = 0;
    
    let m1, m2;
    try {
        m1 = new bootstrap.Modal(document.getElementById('bdUltimateNotice'));
        m2 = new bootstrap.Modal(document.getElementById('bdServiceUpdateModal'));
    } catch(e) { return; }

    function setNoticeCookie(name, days) {
        if (!days || days <= 0) return;
        const date = new Date();
        date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
        document.cookie = name + "=true; expires=" + date.toUTCString() + "; path=/; SameSite=Lax";
    }

    function getNoticeCookie(name) {
        let nameEQ = name + "=";
        let ca = document.cookie.split(';');
        for(let i=0;i < ca.length;i++) {
            let c = ca[i].trim();
            if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length,c.length);
        }
        return null;
    }

    // শুধুমাত্র 'always' এর জন্য sessionStorage অ্যাড করা হয়েছে
    window.handleSrvClick = function(id, cookieName, expiry, freq) {
        if (freq === 'always') {
            sessionStorage.setItem(cookieName, 'true');
        } else if (expiry > 0) {
            setNoticeCookie(cookieName, expiry);
        }
        
        m2.hide();
        setTimeout(function() {
            window.location.href = '/order?service=' + id;
        }, 100);
    };

    fetch(apiUrl).then(res => res.ok ? res.json() : []).then(data => {
        if (Array.isArray(data) && data.length > 0) {
            popupsQueue = data;
            setTimeout(showNext, 200); 
        }
    });

    document.getElementById('bdUltimateNotice').addEventListener('hidden.bs.modal', next);
    document.getElementById('bdServiceUpdateModal').addEventListener('hidden.bs.modal', next);

    function next() {
        currentIndex++; 
        if (currentIndex < popupsQueue.length) setTimeout(showNext, 500); 
    }

    function showNext() {
        const item = popupsQueue[currentIndex];
        if (!item) return;

        const cookieName = "bd_popup_" + item.type + "_" + item.id;
        
        // এখানে sessionStorage চেক করা হচ্ছে
        if (getNoticeCookie(cookieName) || sessionStorage.getItem(cookieName)) {
            next();
            return;
        }

        let freq = item.data.frequency || 'always';
        let expiry = 0;
        if (freq === '1_hour') expiry = 1/24;
        else if (freq === '24_hours') expiry = 1;
        else if (freq === '7_days') expiry = 7;
        else if (freq === 'once') expiry = 365;

        if (item.type === 'system') {
            document.getElementById('dynBadge').innerText = item.data.badge || 'UPDATE';
            document.getElementById('dynTitle').innerText = item.data.title;
            document.getElementById('dynDesc').innerHTML = item.data.description.replace(/\n/g, '<br>');
            
            document.querySelector('#bdUltimateNotice .premium-btn-action').onclick = function() {
                // always হলে সেশন স্টোরেজে সেভ হবে
                if (freq === 'always') sessionStorage.setItem(cookieName, 'true');
                else setNoticeCookie(cookieName, expiry);
            };
            m1.show();
            
        } else if (item.type === 'service') {
            document.getElementById('dynSrvCategory').innerText = item.data.category || 'SERVICE UPDATE';
            let parsed = item.data.parsed_data;
            if (typeof parsed === 'string') { try { parsed = JSON.parse(parsed); } catch(e) { parsed = []; } }
            
            let html = '';
            if (Array.isArray(parsed)) {
                parsed.forEach((s, i) => {
                    html += `
                    <div class="srv-row" style="animation-delay: ${i * 0.05}s" 
                         onclick="handleSrvClick('${s.id}', '${cookieName}', ${expiry}, '${freq}')">
                        <div class="srv-info">
                            <b>ID: ${s.id}</b> - ${s.name}
                        </div>
                        <div class="srv-price">
                            ${s.price}
                        </div>
                    </div>`;
                });
            }
            document.getElementById('dynSrvList').innerHTML = html;

            document.querySelector('.btn-close-srv').onclick = function() {
                // always হলে সেশন স্টোরেজে সেভ হবে
                if (freq === 'always') sessionStorage.setItem(cookieName, 'true');
                else setNoticeCookie(cookieName, expiry);
            };

            document.getElementById('btnJoinChannel').onclick = function() {
                // always হলে সেশন স্টোরেজে সেভ হবে
                if (freq === 'always') sessionStorage.setItem(cookieName, 'true');
                else setNoticeCookie(cookieName, expiry);
                
                m2.hide(); 
                setTimeout(function() {
                    window.open('https://t.me/bdclick24', '_blank'); 
                }, 200);
            };

            m2.show();
        }
    }
});
</script>
