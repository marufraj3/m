<script>
(function () {
    const targetDesc = document.getElementById("service_descriptions");
    let lastContent = "";

    function syncDescription() {
        const sourceDesc = document.querySelector("#service_description .panel-description");
        
        if (!sourceDesc) {
            if (targetDesc.innerHTML !== "") targetDesc.innerHTML = "";
            return;
        }

        const currentRawHTML = sourceDesc.innerHTML.trim();
        if (currentRawHTML === lastContent) return;
        lastContent = currentRawHTML;

        // ১. লেবেলগুলো মুছে ফেলা
        let cleanHtml = currentRawHTML;
        const labels = ['Start time', 'Speed', 'Quality', 'Drop', 'Guarantee', 'Refill', 'Example Link', 'Example', 'Link'];
        labels.forEach(label => {
            const regex = new RegExp(label + '\\s*:\\s*.*?(?=<br>|$|\\n|<div>|<li>)', 'gi');
            cleanHtml = cleanHtml.replace(regex, '');
        });

        // ২. সব ধরণের ট্যাগ এবং স্টারের আগে জোর করে নিউ লাইন (\n) তৈরি করা
        let forcedText = cleanHtml
            .replace(/<br\s*\/?>/gi, '\n')
            .replace(/<\/div>/gi, '\n')
            .replace(/<div>/gi, '\n')
            .replace(/✶/g, '\n') // পুরনো স্টার থাকলে সরিয়ে নিউ লাইন করা
            .replace(/<\/?[^>]+(>|$)/g, ""); // সব HTML ট্যাগ মুছে ফেলা

        // ৩. টেক্সটকে লাইনে লাইনে ভাগ করা এবং স্টার (✶) যোগ করা
        let lines = forcedText.split('\n');
        let finalOutput = "";

        lines.forEach(line => {
            let trimmed = line.trim();
            // বাড়তি ডট বা স্টার থাকলে রিমুভ করে ফ্রেশ টেক্সট নেওয়া
            trimmed = trimmed.replace(/^[✶\*\•\s]+/, '');

            if (trimmed.length > 0 && trimmed !== "-") {
                // প্রতিটি লাইনের শুরুতে স্টার (✶) যোগ করে DIV-এ ঢোকানো
                finalOutput += '<div class="desc-line">✶ ' + trimmed + '</div>';
            }
        });

        targetDesc.innerHTML = finalOutput;
    }

    setInterval(syncDescription, 500);

    $(document).on('change', '#neworder_services', function() {
        setTimeout(syncDescription, 300);
    });
})();
</script>
<script>
(function () {
    let lastServiceId = '';
    let lastHtml = '';

    function resetBoxes() {
        const fields = [
            'serviceStart', 'serviceSpeed', 'serviceQuality', 
            'serviceDropRatio', 'serviceGurantee', 'serviceRefill', 
            'serviceAverageTime', 'serviceExample'
        ];
        fields.forEach(id => {
            const el = document.querySelector(`[data-id="${id}"]`);
            if (el) el.innerText = 'N/A';
        });
    }

    setInterval(function () {
        /* 🔑 REAL TRIGGER: service input */
        const serviceInput =
            document.querySelector('#service') ||
            document.querySelector('[name="service"]') ||
            document.querySelector('[name="service_id"]');

        const serviceId = serviceInput ? serviceInput.value : '';

        /* ❌ NO SERVICE SELECTED */
        if (!serviceId) {
            lastServiceId = '';
            lastHtml = '';
            resetBoxes();
            const el = document.getElementById('service_description');
            if (el) el.removeAttribute('data-original');
            return;
        }

        /* 🔄 SERVICE CHANGED */
        if (serviceId !== lastServiceId) {
            lastServiceId = serviceId;
            lastHtml = '';
            resetBoxes();
        }

        const el = document.getElementById('service_description');
        if (!el) return;

        const html = el.innerHTML.trim();
        if (!html) return;

        const originalHtml = el.getAttribute('data-original') || html;

        if (!el.getAttribute('data-original')) {
            el.setAttribute('data-original', originalHtml);
        }

        if (originalHtml === lastHtml) return;
        lastHtml = originalHtml;

        let workingHtml = originalHtml;

        function extract(label) {
            const r = new RegExp(label + '\\s*:\\s*(.*?)(<br>|$|\\n)', 'i');
            const m = workingHtml.match(r);
            if (!m) return 'N/A';
            // Extract the value and remove the line from description
            workingHtml = workingHtml.replace(m[0], '');
            return m[1].replace(/<\/?[^>]+(>|$)/g, "").trim(); 
        }

        const data = {
            start: extract('Start time'),
            speed: extract('Speed'),
            quality: extract('Quality'),
            drop: extract('Drop'),
            guarantee: extract('Guarantee'),
           refill: extract('Refill'),
            example: extract('(?:Example Link|Example|Link)')
        };

        // Mapping values to HTML
        const mapping = {
            'serviceStart': data.start,
            'serviceSpeed': data.speed,
            'serviceQuality': data.quality,
            'serviceDropRatio': data.drop,
            'serviceGurantee': data.guarantee,
            'serviceRefill': data.refill,
            'serviceExample': data.example
        };

        for (const [id, value] of Object.entries(mapping)) {
            const target = document.querySelector(`[data-id="${id}"]`);
            if (target) target.innerText = value;
        }

        el.innerHTML = workingHtml
            .replace(/<br>\s*<br>/gi, '<br>')
            .replace(/^\s*<br>/gi, '')
            .trim();

    }, 300);
})();
</script>
<script>
(function() {
    function syncAverageTime() {
        // ১. সিস্টেমের অরিজিনাল ডাটা সোর্সগুলো চেক করা
        const sourceInput = document.querySelector('#field-orderform-fields-average_time');
        const sourceLabel = document.querySelector('.average-time');
        const displayBox = document.getElementById('avarage_time');

        if (!displayBox) return;

        let timeValue = "";

        // ২. ভ্যালু কালেক্ট করার চেষ্টা
        if (sourceInput && sourceInput.value && sourceInput.value !== "0") {
            timeValue = sourceInput.value;
        } else if (sourceLabel) {
            // অনেক সময় ইনপুটে থাকে না, টেক্সট আকারে থাকে
            timeValue = sourceLabel.innerText.replace(/Average time|:/gi, '').trim();
        }

        // ৩. ডিসপ্লে বক্সে ডাটা পাঠানো
        if (timeValue && timeValue !== "" && timeValue !== "Not enough data") {
            displayBox.innerText = timeValue;
        } else {
            displayBox.innerText = "Not enough data";
        }
    }

    // ৪. ফর্মের ভেতরের পরিবর্তন লক্ষ্য করা (MutationObserver)
    // এটি AJAX লোড হওয়ার সাথে সাথে কাজ করবে
    const observer = new MutationObserver(function(mutations) {
        syncAverageTime();
    });

    const targetNode = document.querySelector('#neworder_fields') || document.body;
    if (targetNode) {
        observer.observe(targetNode, { 
            childList: true, 
            subtree: true, 
            attributes: true 
        });
    }

    // ৫. অতিরিক্ত ব্যাকআপ হিসেবে সার্ভিস চেঞ্জ ইভেন্ট
    $(document).on('change', '#neworder_services', function() {
        setTimeout(syncAverageTime, 500);
        setTimeout(syncAverageTime, 1500); // একটু দেরি করে আরেকবার চেক
    });

    // প্রথমবার পেজ লোডে রান করা
    window.addEventListener('load', syncAverageTime);
})();
</script>
<script>
(function() {
    /**
     * Syncs Service Name and Min/Max quantity from the hidden inputs/fields
     */
    function syncServiceData() {
        // 1. Update Service Name
        const selectedServiceText = $("#neworder_services option:selected").text();
        if (selectedServiceText) {
            $('#new_services_name').text(selectedServiceText);
        }

        // 2. Update Min/Max Quantity (Directly from hidden inputs)
        const minVal = $('#min').val() || '0';
        const maxVal = $('#max').val() || '0';

        if (minVal !== '0' && minVal !== '') {
            $('#minMax').text(minVal + ' - ' + maxVal);
        } else {
            // Fallback: Try to get text from panel-generated .min-max class
            const panelMinMax = $('.min-max').first().text();
            if (panelMinMax && panelMinMax.trim() !== "") {
                $('#minMax').text(panelMinMax);
            } else {
                $('#minMax').text('0 - 0');
            }
        }
    }

    // Initialize MutationObserver to watch for dynamic changes in the order form
    const observer = new MutationObserver(function(mutations) {
        syncServiceData();
    });

    // Start observing the fields wrapper or body for AJAX updates
    const target = document.querySelector('#neworder_fields') || document.body;
    if (target) {
        observer.observe(target, { 
            attributes: true, 
            childList: true, 
            characterData: true, 
            subtree: true 
        });
    }

    // Event listeners as a backup for category or service changes
    $(document).on('change', '#neworder_services, #neworder_category', function() {
        setTimeout(syncServiceData, 300);
    });

    // Initial run on page load
    $(document).ready(function() {
        setTimeout(syncServiceData, 500);
    });
})();
</script>
<script>
(function () {
    const nameDisplay = document.getElementById('new_services_name');
    const serviceSelect = document.getElementById('neworder_services');

    if (!nameDisplay || !serviceSelect) return;

    function updateTitleWithID() {
        const option = serviceSelect.options[serviceSelect.selectedIndex];
        if (!option || !option.value || option.value === "") return;

        const serviceId = option.value;
        const serviceName = option.text.trim();
        const expectedTitle = serviceId + " - " + serviceName;

        // যদি অলরেডি আইডি বসানো না থাকে, তবেই বসাবে
        if (nameDisplay.innerText !== expectedTitle) {
            nameDisplay.innerText = expectedTitle;
        }
    }

    // ১. টাইটেল বক্সের ওপর নজর রাখা (যদি প্যানেল নাম পাল্টে দেয়, আমরা আবার আইডি বসাবো)
    const observer = new MutationObserver(updateTitleWithID);
    observer.observe(nameDisplay, { characterData: true, childList: true, subtree: true });

    // ২. সার্ভিস ড্রপডাউন চেঞ্জ হলে
    $(document).on('change', '#neworder_services', function () {
        updateTitleWithID();
    });

    // ৩. ক্যাটাগরি চেঞ্জ হওয়ার পর ডাটা আসার জন্য ইন্টারভল চেক
    $(document).on('change', '#neworder_category', function () {
        let attempts = 0;
        let timer = setInterval(function() {
            updateTitleWithID();
            attempts++;
            if(attempts > 10) clearInterval(timer);
        }, 500);
    });

    // ৪. সেফটি হিসেবে প্রতি ১ সেকেন্ডে একবার চেক
    setInterval(updateTitleWithID, 1000);

    // প্রথমবার লোডে
    $(document).ready(function() {
        setTimeout(updateTitleWithID, 500);
    });
})();
</script>
<script>
    (function() {
        var alertBox = document.getElementById('low-balance-alert');
        var rawBalance = '{{ user["balance"] }}';
        var currencyCode = '{{ user["currency"] }}' || 'USD';
        
        // 1. Balance Clean kora
        var balance = parseFloat(rawBalance.replace(/,/g, '').replace(/[^0-9.]/g, '')) || 0;

        // 2. Local Storage theke data check kora
        var savedData = localStorage.getItem('currency_rate_data');
        var now = new Date().getTime();
        var sevenDays = 7 * 24 * 60 * 60 * 1000; // 7 diner millisecond

        function applyLogic(rate) {
            var minLimit = 1.00 * rate;
            if (balance < minLimit) {
                alertBox.style.display = 'block';
            } else {
                alertBox.style.display = 'none';
            }
        }

        // 3. Jodi age theke rate save thake ebong 7 din na hoy
        if (savedData) {
            var parsed = JSON.parse(savedData);
            if ((now - parsed.timestamp) < sevenDays && parsed.currency === currencyCode) {
                console.log("Using cached rate for 7 days...");
                applyLogic(parsed.rate);
                return; // Script ekhanei sesh, no API call
            }
        }

        // 4. Jodi rate na thake ba 7 din par hoye jay, tobe API call hobe
        fetch('https://open.er-api.com/v6/latest/USD')
            .then(res => res.json())
            .then(data => {
                var liveRate = data.rates[currencyCode] || parseFloat('{{ user["currency_rate"] }}') || 1;
                
                // Rate-ta save kore rakha jate agami 7 din call na hoy
                var dataToSave = {
                    rate: liveRate,
                    timestamp: now,
                    currency: currencyCode
                };
                localStorage.setItem('currency_rate_data', JSON.stringify(dataToSave));
                
                applyLogic(liveRate);
            })
            .catch(err => {
                // API fail korle backend rate use korbe
                var backRate = parseFloat('{{ user["currency_rate"] }}') || 1;
                applyLogic(backRate);
            });
    })();
</script>
<script>
/* ================================================
   Category + Service Select2 -> FULL RESPONSIVE
   - Select box sob somoy 100% width
   - Dropdown select box er width e khule (screen er baire jay na)
   - Resize / rotate / scroll e position + width auto sync
   - Sob somoy niche khule (flip off)
================================================ */
(function () {
  if (!window.jQuery) return;
  var $ = window.jQuery;

  function fixSelectWidth() {
    // Select2 inline style e "width: 123px" / "auto" bosay -> sob somoy 100% kore dei
    $('.component_button_forms .select2-container').css({
      width: '100%',
      maxWidth: '100%'
    });
  }

  function patchSelect2() {
    if (!$.fn || !$.fn.select2 || !$.fn.select2.amd) return false;

    var AttachBody = $.fn.select2.amd.require('select2/dropdown/attachBody');
    if (!AttachBody || AttachBody.prototype.__bdResponsivePatched) return true;
    AttachBody.prototype.__bdResponsivePatched = true;

    var oldPosition = AttachBody.prototype._positionDropdown;
    var oldResize   = AttachBody.prototype._resizeDropdown;

    // Dropdown width = select box width (never wider than the screen)
    AttachBody.prototype._resizeDropdown = function () {
      oldResize.call(this);

      var $container = this.$container;
      var $dropdown  = this.$dropdown;
      if (!$container || !$container.length) return;

      var w    = $container.outerWidth(false);
      var maxW = $(window).width() - 16;
      if (w > maxW) w = maxW;

      $dropdown.css({
        width: w + 'px',
        minWidth: 0,
        maxWidth: maxW + 'px'
      });
    };

    // Always open BELOW the select box and align to its left edge
    AttachBody.prototype._positionDropdown = function () {
      oldPosition.call(this);

      var $container = this.$container;
      var $dropdown  = this.$dropdown;
      if (!$container || !$container.length) return;

      $dropdown.removeClass('select2-dropdown--above').addClass('select2-dropdown--below');
      $container.removeClass('select2-container--above').addClass('select2-container--below');

      var off  = $container.offset();
      var h    = $container.outerHeight(false);
      var w    = $dropdown.outerWidth(false);
      var left = off.left;
      var maxLeft = $(window).width() - w - 8;
      if (left > maxLeft) left = Math.max(8, maxLeft);

      $dropdown.css({
        top: (off.top + h) + 'px',
        left: left + 'px',
        bottom: 'auto'
      });
    };

    return true;
  }

  // Select2 already loaded? patch now. Else wait for footer scripts.
  if (!patchSelect2()) {
    var tries = 0;
    var t = setInterval(function () {
      tries++;
      if (patchSelect2() || tries > 50) clearInterval(t);
    }, 200);
  }

  // Keep the select box 100% wide at all times (init + re-init by the panel)
  $(function () {
    fixSelectWidth();

    var host = document.querySelector('.component_button_forms') || document.body;
    if (window.MutationObserver) {
      new MutationObserver(fixSelectWidth).observe(host, { childList: true, subtree: true });
    }

    $(document).on('select2:open', '#neworder_category, #neworder_services', function () {
      fixSelectWidth();
      // Mobile keyboard/rotate: re-measure after the layout settles
      var $el = $(this);
      setTimeout(function () {
        var inst = $el.data('select2');
        if (inst && inst.dropdown && inst.dropdown._positionDropdown) {
          inst.dropdown._resizeDropdown();
          inst.dropdown._positionDropdown();
        }
      }, 50);
    });

    // Resize / rotate / scroll: re-sync open dropdown; close on orientation change
    var raf = null;
    function resync() {
      if (raf) return;
      raf = requestAnimationFrame(function () {
        raf = null;
        fixSelectWidth();
        $('#neworder_category, #neworder_services').each(function () {
          var inst = $(this).data('select2');
          if (inst && inst.isOpen && inst.isOpen() && inst.dropdown && inst.dropdown._positionDropdown) {
            inst.dropdown._resizeDropdown();
            inst.dropdown._positionDropdown();
          }
        });
      });
    }
    $(window).on('resize', resync);
    $(window).on('scroll', resync);
    $(window).on('orientationchange', function () {
      $('#neworder_category, #neworder_services').each(function () {
        var inst = $(this).data('select2');
        if (inst && inst.isOpen && inst.isOpen()) $(this).select2('close');
      });
      setTimeout(resync, 300);
    });
  });
})();
</script>

<script>
document.addEventListener("DOMContentLoaded",function(){

const modalEl=document.getElementById("myModal");
if(!modalEl)return;

/* ===============================
   AUTO HEADER THEME COLOR
================================*/
const themeHeader=
document.querySelector(".card_auth_1 .card-header");

const modalHeader=
document.querySelector("#myModal .bdTgHeader");

if(themeHeader && modalHeader){
 let s=getComputedStyle(themeHeader);
 modalHeader.style.background=s.background;
 modalHeader.style.color=s.color;
}

/* ===============================
   AUTO BODY BACKGROUND
================================*/
const sourceBox=document.querySelector(
".daymode .infos_item .info_box,\
 .daymode .example_link .example_set,\
 .daymode .service_descriptions #service_descriptions"
);

const modalBox=
document.querySelector("#myModal .bdTgBox");

if(sourceBox && modalBox){
 let s=getComputedStyle(sourceBox);
 modalBox.style.background=s.background;
 modalBox.style.border=s.border;
 modalBox.style.boxShadow=s.boxShadow;
}

/* ===============================
   COOKIE SAFE
================================*/
function hasCookie(name){
 return document.cookie.split("; ")
 .some(row=>row.startsWith(name+"="));
}

if(typeof bootstrap==="undefined")return;

if(!hasCookie("bd_tg_popup")){

 let modal=new bootstrap.Modal(modalEl);
 modal.show();

 let d=new Date();
 d.setTime(d.getTime()+7*24*60*60*1000);

 document.cookie=
 "bd_tg_popup=1; expires="+
 d.toUTCString()+
 "; path=/; SameSite=Lax";
}

});
</script>
